          {
            "text": "Claude: investiga",
            "atWord": "investigó"
          }
        ]
      }
    },
    {
      "id": "guion",
      "section": "ejemplo",
      "narration": "Luego escribió el guion. Es un archivo de datos: cada escena dice qué se narra y qué se muestra.",
      "transitionIn": "fade",
      "visual": {
        "type": "code",
