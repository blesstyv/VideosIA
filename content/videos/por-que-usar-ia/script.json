    {
      "id": "limites",
      "section": "desarrollo",
      "narration": "También tiene límites: la IA puede equivocarse. Por eso cada dato se verifica y todo se revisa antes de publicar.",
      "transitionIn": "fade",
      "visual": {
        "type": "kinetic",
        "text": "La IA puede equivocarse",
        "emphasis": [
          "equivocarse"
