        "language": "text"
      }
    },
    {
      "id": "humano",
      "section": "desarrollo",
      "narration": "Pero la IA no decide sola. Yo pongo la idea y apruebo el resultado; Claude investiga, escribe y produce.",
      "transitionIn": "fade",
      "visual": {
        "type": "verdict",
        "title": "Quién hace qué",
        "items": [
          {
            "profile": "Yo",
            "pick": "Idea y aprobación",
            "atWord": "idea"
