    {
      "id": "cambios",
      "section": "desarrollo",
      "narration": "Si algo no te gusta, lo pides en una frase. La voz del video anterior iba lenta, pedí más velocidad y se ajustó.",
      "transitionIn": "fade",
      "visual": {
        "type": "chat",
        "window": "Terminal",
        "side": "n",
        "terminal": true,
        "prompt": "Habla un poco más rápido",
