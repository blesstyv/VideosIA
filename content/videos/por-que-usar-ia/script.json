          {
            "profile": "Claude",
            "pick": "Investiga y produce",
            "atWord": "investiga,"
          }
        ]
      }
    },
    {
      "id": "ventajas",
      "section": "desarrollo",
      "narration": "¿Las ventajas? Velocidad, porque todo ocurre en una sola conversación. Y consistencia, porque cada video sigue el mismo flujo.",
      "transitionIn": "fade",
      "visual": {
        "type": "bullets",
        "heading": "Ventajas",
        "items": [
          {
            "text": "Velocidad",
            "atWord": "velocidad,"
          },
          {
            "text": "Consistencia",
            "atWord": "consistencia,"
          }
        ]
      },
      "background": {
        "kind": "aurora"
      }
    },
    {
      "id": "ventajas-2",
      "section": "desarrollo",
      "narration": "Datos con fuente, porque cada afirmación queda registrada. Y si cambias de tema, repites el flujo en vez de empezar de cero.",
      "transitionIn": "fade",
      "visual": {
        "type": "versus",
