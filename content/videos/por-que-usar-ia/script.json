    {
      "id": "por-que",
      "section": "intro",
      "narration": "¿Por qué usar IA? Porque un video son muchas tareas: investigar, escribir, narrar, animar y revisar. Y casi siempre las haces tú solo.",
      "transitionIn": "fade",
      "visual": {
        "type": "bullets",
        "heading": "Un video son muchas tareas",
        "items": [
          {
            "text": "Investigar",
            "atWord": "investigar"
          },
          {
            "text": "Escribir",
            "atWord": "escribir"
          },
          {
            "text": "Narrar y animar",
            "atWord": "narrar"
          },
          {
            "text": "Revisar",
            "atWord": "revisar"
          }
        ]
      }
    },
    {
      "id": "herramienta",
      "section": "desarrollo",
      "narration": "Yo uso Claude Code, de Anthropic: una herramienta que lee tu proyecto, edita archivos y ejecuta comandos por ti.",
      "transitionIn": "slide",
      "visual": {
        "type": "title",
        "kicker": "La herramienta",
        "title": "*Claude* Code",
        "subtitle": "Lee tu proyecto, edita y ejecuta"
