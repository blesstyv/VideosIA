            "atWord": "renderizó"
          },
          {
            "text": "Validación",
            "atWord": "validó"
          }
        ]
      }
    },
    {
      "id": "revision",
      "section": "ejemplo",
      "narration": "Y lo más importante: Claude revisó los fotogramas uno por uno, buscando texto cortado o encimado, y corrigió lo que fallaba.",
      "transitionIn": "fade",
      "visual": {
        "type": "kinetic",
        "text": "Revisó los fotogramas uno por uno",
