      "background": {
        "kind": "grid"
      }
    },
    {
      "id": "tema",
      "section": "ejemplo",
      "narration": "Así nació este video. Primero le di el tema, y Claude investigó en la documentación oficial.",
      "transitionIn": "fade",
      "visual": {
        "type": "bullets",
        "heading": "Pasos 1 y 2",
        "items": [
          {
            "text": "Yo: el tema",
